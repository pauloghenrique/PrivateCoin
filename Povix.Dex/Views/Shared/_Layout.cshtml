<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title · Povix.Dex</title>
    <meta name="description" content="Crie tokens e pools de liquidez e troque ativos na blockchain POVIX com assinatura local da sua carteira." />
    <link rel="stylesheet" href="@Styles.Url("~/bundles/povix-styles")" />
</head>
<body class="@ViewBag.PageClass">
    <header class="site-header">
        <a class="brand" href="@Url.Action("Index", "Home")" aria-label="Povix.Dex início"><span class="brand-mark">P</span><span>povix<span class="brand-dex">.dex</span></span></a>
        <nav aria-label="Navegação principal"><a class="@(ViewContext.RouteData.Values["controller"].ToString() == "Home" ? "nav-active" : "")" href="@Url.Action("Index", "Home")">Mercado</a><a class="@((ViewContext.RouteData.Values["controller"].ToString() == "Tokens" || ViewContext.RouteData.Values["controller"].ToString() == "TokenProfiles") ? "nav-active" : "")" href="@Url.Action("Index", "Tokens")">Token</a><a class="@(ViewContext.RouteData.Values["controller"].ToString() == "Liquidity" ? "nav-active" : "")" href="@Url.Action("Index", "Liquidity")">Pools</a><a href="@Url.Action("Index", "Bridge")">Swap BNB</a><a href="#wallet-menu" data-wallet-open><span data-wallet-label>Conectar carteira</span></a><span class="network-label"><i></i> Blockchain POVIX</span></nav>
    </header>
    <dialog id="wallet-menu" aria-label="Conexão da carteira"><button type="button" id="wallet-close" class="text-button">Fechar</button>@Html.Partial("_Wallet")<p id="wallet-message" role="status"></p></dialog>
    <div class="page-shell">@RenderBody()</div>
    <footer class="site-footer"><span>POVIX · Infraestrutura para seus ativos</span><span>Assinatura local. Registro na blockchain.</span></footer>
    <script src="@Scripts.Url("~/bundles/povix-wallet")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
