                <small>9 capítulos · 12 min</small>
            </div>
            <nav>
                <a href="#resumo"><span>01</span> Resumo</a>
                <a href="#principios"><span>02</span> Princípios</a>
                <a href="#arquitetura"><span>03</span> Arquitetura</a>
