{
  "name": "povix-bnb-bridge",
  "version": "0.2.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node src/compile.mjs",
    "test": "node --test test/*.test.mjs",
    "deploy:testnet": "node src/cli.mjs deploy",
    "bridge": "node src/cli.mjs",
    "test:native-build": "sh test/native-build.sh",
    "test:production": "node --test test/production*.test.mjs",
    "deploy:production": "node src/cli.mjs deploy",
    "package:production": "node src/package-production.mjs",
    "test:csharp": "node --test test/csharp-keystores.integration.mjs test/csharp-production.integration.mjs",
    "test:automation": "node --test test/automation.integration.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "ganache": "7.9.2",
    "solc": "0.8.30"
  },
  "description": "Federated BNB custody and native POVIX bridge; production candidate, disabled by default"
}
