@{
    ViewBag.Title = "Mercado de pools";
    ViewBag.PageClass = "dex-home";
}
<main data-initial-catalogue="@ViewBag.InitialCatalogue" id="dex-home" data-catalogue-url="@Url.Action("Catalogue", "Liquidity")" data-market-url="@Url.Action("Market", "Liquidity")">
    @Html.AntiForgeryToken()
    <section class="dex-hero">
        <div><span class="eyebrow">POVIX DECENTRALIZED EXCHANGE</span><h1>O mercado da sua rede.<br /><span>Explore os pares.</span></h1><p>Explore pools de tokens da blockchain POVIX e negocie com assinatura local.</p><a class="button button-primary" href="@Url.Action("Index", "Liquidity")">Explorar pools <span aria-hidden="true">↗</span></a><a class="button" href="@Url.Action("Create", "Tokens")">Criar um token →</a></div>
        <aside class="dex-network"><span class="eyebrow">UMA REDE. NOVAS POSSIBILIDADES.</span><div class="dex-orbit" aria-hidden="true"><span>P</span><i>◇</i><b>⇄</b></div><strong>Blockchain POVIX</strong><p>Seus ativos. Sua carteira. Seu controle.</p></aside>
    </section>
    <section class="dex-metrics" aria-label="Resumo do catálogo"><div><span>Ativos em pools</span><strong id="dex-asset-count">—</strong></div><div><span>Pools da rede</span><strong id="dex-pool-count">—</strong></div><div><span>Rede de negociação</span><strong>POVIX <em>Nativa</em></strong></div></section>
    <section class="card dex-list dex-launches" aria-labelledby="dex-launch-title">
        <div class="dex-list-heading"><div><span class="eyebrow">ACOMPANHE OS LANÇAMENTOS</span><h2 id="dex-launch-title">Pools em lançamento</h2><p>Pools em captação, antes da abertura da negociação.</p></div></div>
        <p id="dex-launch-status" class="dex-status" role="status" aria-live="polite">Consultando o catálogo da rede…</p>
        <div class="dex-table-wrap"><table class="dex-table"><thead><tr><th scope="col">Par</th><th scope="col">Identificação da pool</th><th scope="col">Reservas</th><th scope="col">Status e acesso</th></tr></thead><tbody id="dex-launch-list"></tbody></table></div>
        <div class="dex-list-footer"><span id="dex-launch-count">Aguardando catálogo</span><span>Atualização automática a cada 15 segundos.</span></div>
    </section>
    <section class="card dex-list" aria-labelledby="dex-list-title">
        <div class="dex-list-heading"><div><span class="eyebrow">DESCUBRA O ECOSSISTEMA</span><h2 id="dex-list-title">Pools já lançadas</h2><p>Pares disponíveis para negociação na rede POVIX.</p></div><button id="dex-refresh" class="button button-secondary" type="button">Atualizar ↻</button></div>
        <div class="dex-tools"><div><label class="dex-search-label" for="dex-search">Buscar nas duas listas</label><input type="search" id="dex-search" placeholder="Par, token ou ID da pool" /></div></div>
        <p id="dex-status" class="dex-status" role="status" aria-live="polite">Consultando o catálogo da rede…</p>
        <div class="dex-table-wrap"><table class="dex-table"><thead><tr><th scope="col">Par</th><th scope="col">Identificação da pool</th><th scope="col">Reservas</th><th scope="col">Status e acesso</th></tr></thead><tbody id="dex-token-list"></tbody></table></div>
        <div class="dex-list-footer"><span id="dex-result-count">Aguardando catálogo</span><span>Disponibilidade conforme esta instalação do DEX.</span></div>
    </section>
    <p class="dex-disclaimer">As pools listadas não representam recomendação de investimento.</p>
</main>
@section scripts {
    <script src="@Scripts.Url("~/bundles/povix-home")"></script>
}
