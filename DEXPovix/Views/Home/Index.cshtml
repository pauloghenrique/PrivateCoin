@{ Layout = null; }
<!doctype html><html lang="pt-BR"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>DEXPovix · Token Studio</title><style>
*{box-sizing:border-box}body{background:#0b1118;color:#edf4fa;font:15px/1.6 system-ui;margin:0}header{padding:22px 6%;border-bottom:1px solid #283641;display:flex;justify-content:space-between}b.logo{font-size:23px}em{color:#adf477;font-style:normal}main{max-width:1100px;margin:auto;padding:45px 24px}h1{font-size:clamp(36px,5vw,54px);letter-spacing:-2px;margin:12px 0}p,small{color:#9aacbb}.tag{color:#adf477;font-size:11px;letter-spacing:2px}.grid{display:grid;grid-template-columns:1.25fr 1fr;gap:24px;margin-top:35px}.panel{background:#121d27;border:1px solid #2a3743;border-radius:16px;padding:28px}h2{margin:0;font-size:20px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:24px}.full{grid-column:1/-1}label{display:block;font-size:13px;margin-bottom:7px}input,select,button{font:inherit;border-radius:8px;padding:13px;width:100%;border:1px solid #364857;background:#0b141d;color:white}input:focus,select:focus{outline:2px solid #adf477}small{font-size:12px}button{cursor:pointer;margin-top:16px;font-weight:650}.primary{background:#adf477;color:#192910;border:0}.row{display:flex;justify-content:space-between;gap:15px;border-bottom:1px solid #2a3743;padding:15px 0;font-size:13px}.row span{color:#9aacbb}.row strong{max-width:65%;overflow-wrap:anywhere;text-align:right}.coin{font-size:30px;color:#adf477;padding:25px 0}.notice{padding:16px;background:#46391d55;border:1px solid #796036;border-radius:9px;color:#e3c893;font-size:12px;margin-top:24px}.notice strong{display:block}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;margin-top:28px}.features h3{font-size:14px}.features p{font-size:12px}footer{border-top:1px solid #2a3743;padding-top:22px;margin-top:35px;color:#9aacbb;font-size:12px}#msg{font-size:13px;min-height:24px}dialog{background:#121d27;color:white;border:1px solid #364857;border-radius:14px;max-width:520px;width:calc(100% - 30px);padding:26px}dialog::backdrop{background:#000b}pre{white-space:pre-wrap;overflow-wrap:anywhere;color:#adf477;max-height:300px;overflow:auto}@@media(max-width:750px){.grid,.features{grid-template-columns:1fr}header small{max-width:130px;text-align:right}.panel{padding:20px}}@@media(max-width:400px){.fields{grid-template-columns:1fr}.full{grid-column:auto}}
</style><header><b class="logo"><em>◈</em> DEXPovix</b><small>Token Studio · Configuração local</small></header><main><div class="tag">PRIVATECOIN ECOSYSTEM</div><h1>Seu token começa aqui.</h1><p>Configure a identidade e a quantidade do seu token.<br>Revise os detalhes e prepare os parâmetros para o PrivateCoin.Core.</p><div class="grid"><section class="panel"><h2>Configure seu token</h2><small>01 Configurar → 02 Revisar → 03 Exportar</small><form id="form"><div class="fields"><div class="full"><label for="name">Nome do token</label><input id="name" value="Povix Community" maxlength="64" required><small>Até 64 caracteres.</small></div><div><label for="symbol">Símbolo</label><input id="symbol" value="PVC" maxlength="10" pattern="[A-Z]{1,10}" required><small>De 1 a 10 letras A–Z.</small></div><div><label for="decimals">Casas decimais</label><select id="decimals"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>7</option><option selected>8</option></select><small>Precisão de 0 a 8 casas.</small></div><div class="full"><label for="supply">Quantidade total de tokens</label><input id="supply" value="1000000" inputmode="decimal" required><small>Ponto ou vírgula para decimais, sem separador de milhar.</small></div></div><p><em>◇</em> Quantidade fixa, sem emissão adicional ou queima.</p><button class="primary" type="submit">Revisar configuração ↗</button><button id="save" type="button">Salvar rascunho neste navegador</button><p id="msg" role="status" aria-live="polite"></p></form></section><aside class="panel"><div class="tag">PRÉVIA DO TOKEN</div><div class="coin">◈ <strong id="pn"></strong></div><div class="row"><span>Símbolo</span><strong id="ps"></strong></div><div class="row"><span>Quantidade total</span><strong id="pq"></strong></div><div class="row"><span>Casas decimais</span><strong id="pd"></strong></div><div class="row"><span>Unidades atômicas</span><strong id="pa"></strong></div><div class="row"><span>Taxa de criação</span><strong>Em POVIX, definida pelo nó</strong></div><div class="notice"><strong>Integração com a rede pendente</strong>Esta tela prepara uma configuração. Nenhum token é criado e nenhuma transação é enviada. A criação exige carteira, saldo em POVIX e conexão com um nó compatível.</div><p><small>○ Carteira e nó não conectados</small></p></aside></div><div class="features"><article><div class="tag">01 / IDENTIDADE</div><h3>Um nome para sua comunidade</h3><p>Símbolos podem se repetir. Após a criação, o identificador distingue cada token.</p></article><article><div class="tag">02 / PRECISÃO</div><h3>Defina a menor fração</h3><p>As casas decimais determinam a divisibilidade. A quantidade é convertida sem perda de precisão.</p></article><article><div class="tag">03 / CORE</div><h3>Regras nativas PrivateCoin</h3><p>O Core disponível usa TokenCreate e TokenTransfer, sem máquina virtual ou suporte a Solidity.</p></article></div><footer>◈ DEXPovix · Rascunhos ficam apenas neste navegador.</footer></main><dialog id="review"><h2>Revise seu token</h2><p>Este arquivo contém parâmetros de configuração. Não é uma transação assinada.</p><pre id="json"></pre><button id="download" class="primary">Baixar configuração JSON</button><button id="close">Voltar</button></dialog><script>
const $=id=>document.getElementById(id),ids=['name','symbol','decimals','supply'];let config;
function build(name,symbol,decimals,supply){name=name.trim();supply=supply.trim().replace(',','.');if(!name||name.length>64||/[\x00-\x1f\x7f]/.test(name))throw Error('Nome inválido. Use até 64 caracteres.');if(!/^[A-Z]{1,10}$/.test(symbol))throw Error('Use de 1 a 10 letras A–Z no símbolo.');if(!Number.isInteger(decimals)||decimals<0||decimals>8)throw Error('Precisão inválida.');if(!/^\d+(\.\d+)?$/.test(supply))throw Error('Informe uma quantidade positiva, sem separador de milhar.');const [whole,fraction='']=supply.split('.');if(fraction.length>decimals)throw Error('A quantidade excede as casas decimais selecionadas.');const units=BigInt(whole)*10n**BigInt(decimals)+BigInt(fraction.padEnd(decimals,'0')||'0');if(units<1n||units>9223372036854775807n)throw Error('A quantidade atômica deve estar entre 1 e 9223372036854775807.');return {format:'dexpovix-token-config-v1',status:'configuration-only',token:{Name:name,Symbol:symbol,Decimals:decimals,Supply:units.toString()},displaySupply:supply};}
function read(){return build($('name').value,$('symbol').value,Number($('decimals').value),$('supply').value)}function update(){$('pn').textContent=$('name').value||'Seu token';$('ps').textContent=$('symbol').value;$('pq').textContent=$('supply').value;$('pd').textContent=$('decimals').value;try{$('pa').textContent=read().token.Supply}catch(e){$('pa').textContent='Confira os parâmetros'}}ids.forEach(id=>$(id).addEventListener('input',()=>{if(id==='symbol')$(id).value=$(id).value.toUpperCase();$('msg').textContent='';update()}));$('form').onsubmit=e=>{e.preventDefault();try{config=read();$('json').textContent=JSON.stringify(config,null,2);$('review').showModal()}catch(e){$('msg').textContent=e.message}};$('save').onclick=()=>{try{read();localStorage.setItem('dexpovix-draft',JSON.stringify(Object.fromEntries(ids.map(id=>[id,$(id).value]))));$('msg').textContent='Rascunho salvo neste navegador.'}catch(e){$('msg').textContent=e.message}};$('close').onclick=()=>$('review').close();$('download').onclick=()=>{const url=URL.createObjectURL(new Blob([JSON.stringify(config,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='dexpovix-'+config.token.Symbol+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);$('review').close();$('msg').textContent='Configuração exportada. Nenhuma transação foi enviada.'};try{const draft=JSON.parse(localStorage.getItem('dexpovix-draft'));if(draft&&ids.every(id=>typeof draft[id]==='string')&&/^[0-8]$/.test(draft.decimals)){ids.forEach(id=>$(id).value=draft[id]);$('msg').textContent='Rascunho recuperado.'}}catch(e){}update();
</script></html>
