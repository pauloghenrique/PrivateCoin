@{
    ViewBag.Title = "Mercado de pools";
    ViewBag.PageClass = "dex-home";
}
<main id="dex-home" data-catalogue-url="@Url.Action("Catalogue", "Liquidity")" data-market-url="@Url.Action("Market", "Liquidity")">
    @Html.AntiForgeryToken()
    <section class="dex-overview"><div><span class="eyebrow">MERCADO POVIX</span><h1>O mercado, em um só lugar.</h1><p>Explore os pares e a liquidez da sua rede.</p></div><span class="status-pill">Blockchain POVIX</span></section>
    <section class="dex-market-strip" aria-label="Resumo do catálogo"><span>Ativos em pools <strong id="dex-asset-count">—</strong></span><span>Pools disponíveis <strong id="dex-pool-count">—</strong></span><span>Rede <strong>POVIX</strong></span></section>
    <div class="dex-dashboard">
    <section class="card dex-list" aria-labelledby="dex-list-title">
        <div class="dex-list-heading"><div><h2 id="dex-list-title">PARES DISPONÍVEIS <span class="info" title="Pools disponíveis no catálogo desta instalação">ⓘ</span></h2></div><button id="dex-refresh" class="button button-secondary" type="button">Atualizar ↻</button></div>
        <div class="dex-tools"><div><label class="dex-search-label" for="dex-search">Buscar pool</label><input type="search" id="dex-search" placeholder="Par A/B, token ou ID da pool" /></div></div>
        <p id="dex-status" class="dex-status" role="status" aria-live="polite">Consultando o catálogo da rede…</p>
        <div class="dex-table-wrap"><table class="dex-table"><thead><tr><th scope="col">Par A/B</th><th scope="col">Reservas A / B</th><th scope="col">Negociação</th></tr></thead><tbody id="dex-token-list"></tbody></table></div>
        <div class="dex-list-footer"><span id="dex-result-count">Aguardando catálogo</span><span>Disponibilidade conforme esta instalação do DEX.</span></div>
    </section>
    <div class="dex-dashboard-column"><section class="card dex-panel"><div class="dex-panel-heading"><h2>POOLS DO CATÁLOGO</h2><span class="dex-panel-tag">POVIX</span></div><div id="dex-catalogue-pools"><p class="dex-panel-empty">Aguardando consulta à rede.</p></div><a class="dex-panel-footer" href="@Url.Action("Index", "Liquidity")">Explorar pools e trocas <span>↗</span></a></section><section class="card dex-panel"><div class="dex-panel-heading"><h2>ATIVOS EM POOLS</h2></div><div id="dex-catalogue-assets"><p class="dex-panel-empty">Aguardando consulta à rede.</p></div></section></div>
    <div class="dex-dashboard-column"><section class="card dex-panel"><div class="dex-panel-heading"><h2>VISITADOS RECENTEMENTE</h2></div><div id="dex-recent-pools"><p class="dex-panel-empty">Os pares que você abrir aparecerão aqui.</p></div></section><aside class="dex-home-callout"><span class="eyebrow">SEUS ATIVOS. SUA REDE.</span><h2>Seu próximo movimento<br />começa aqui.</h2><p>Crie ativos e explore as possibilidades da blockchain POVIX.</p><a href="@Url.Action("Create", "Tokens")">Criar um token ↗</a></aside></div>
    </div>
    <p class="dex-disclaimer">As pools listadas não representam recomendação de investimento.</p>
</main>
@section scripts {
    <script src="@Url.Content("~/Scripts/povix-home.js")"></script>
}
