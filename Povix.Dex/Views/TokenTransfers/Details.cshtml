@model Povix.Dex.Models.TokenTransferReceiptViewModel
@using Povix.Dex.Models
@{ ViewBag.Title = "Comprovante de movimentação"; }
<main id="registration-app" class="receipt-page" data-operation="transfer" data-status-url="@Url.Action("Status", new { id = Model.TransactionId })">
    <a class="back-link" href="@Url.Action("Index", new { tokenId = Model.Token.Id })">← Movimentar este token</a>
    <div class="page-intro"><span class="eyebrow">MOVIMENTAÇÃO NA BLOCKCHAIN</span><h1 id="receipt-title">@(Model.Status == "confirmed" ? "Movimentação confirmada." : Model.Status == "pending" ? "Transação enviada." : "Movimentação não confirmada.")</h1><p id="receipt-description">@(Model.Status == "confirmed" ? "A transferência consta em um bloco validado da rede POVIX." : Model.Status == "pending" ? "O envio aguarda confirmação em um bloco validado." : "A transação deixou a fila. Confira os saldos antes de tentar novamente.")</p></div>
    <section class="card receipt-card"><div class="receipt-heading"><div class="token-identity"><span class="token-avatar">@Model.Token.Symbol.Substring(0, 1)</span><div><strong>@Model.Token.Name</strong><span>@Model.Token.Symbol</span></div></div><span id="receipt-status" class="status-pill">@(Model.Status == "confirmed" ? "Confirmado" : Model.Status == "pending" ? "Pendente" : "Não confirmado")</span></div>
        <div class="receipt-stats"><div><span>Quantidade enviada</span><strong>@TokenNetworkViewModel.FormatToken(Model.Amount, Model.Token.Decimals) @Model.Token.Symbol</strong></div><div><span>Taxa em POVIX</span><strong>@TokenNetworkViewModel.FormatPovix(Model.Fee)</strong></div><div><span>Confirmações</span><strong id="receipt-confirmations">@Model.Confirmations</strong></div></div>
        <dl class="receipt-data"><dt>Identificador do token</dt><dd>@Model.Token.Id</dd><dt>Transação</dt><dd>@Model.TransactionId</dd><dt>Endereço de recebimento</dt><dd>@Model.DestinationAddress</dd><dt>Bloco</dt><dd id="receipt-block">@(Model.BlockHeight.HasValue ? Model.BlockHeight.Value.ToString() : "Aguardando confirmação")</dd><dt>Hash do bloco</dt><dd id="receipt-hash">@(Model.BlockHash ?? "—")</dd>
            @foreach (var output in Model.ChangeOutputs)
            {
                <dt>@(output.AssetId == null ? "Troco em POVIX" : "Troco do token")</dt><dd>@TokenNetworkViewModel.FormatToken(output.Amount, output.AssetId == null ? 8 : Model.Token.Decimals) @(output.AssetId == null ? "POVIX" : Model.Token.Symbol)</dd><dt>Endereço do troco</dt><dd>@output.OneTimeAddress</dd>
            }
        </dl><p id="receipt-connectivity" class="muted-text">@Model.PeerCount pares conectados · Atualização automática a cada 10 segundos</p>
    </section>
</main>
@section scripts { <script src="@Url.Content("~/Scripts/povix-token-status.js")"></script> }
