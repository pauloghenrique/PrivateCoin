<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <!-- Bootstrap público no formato host:porta, separado por vírgulas. Pode haver vários. -->
        <add key="PeerSeeds" value="162.35.25.246:4778" />
        <add key="AutoStartNode" value="true" />
        <add key="ListenPort" value="4778" />
        <!-- UPnP/NAT-PMP abre a porta automaticamente quando o roteador oferece suporte. -->
        <add key="EnableNatTraversal" value="true" />
        <!-- Manifesto JSON HTTPS da versão publicada. Vazio desativa a consulta automática. -->
        <add key="UpdateManifestUrl" value="" />
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
</configuration>
