@{
    ViewBag.Title = "Mercado de tokens";
    ViewBag.PageClass = "dex-home";
}
<main id="dex-home" data-catalogue-url="@Url.Action("Catalogue", "Liquidity")" data-market-url="@Url.Action("Market", "Liquidity")" data-pools-url="@Url.Action("Index", "Liquidity")">
    @Html.AntiForgeryToken()
    <section class="dex-hero">
        <div><span class="eyebrow">POVIX DECENTRALIZED EXCHANGE</span><h1>O mercado da sua rede.<br /><span>Explore cada token.</span></h1><p>Descubra os ativos da blockchain POVIX e encontre pools para negociar com assinatura local.</p><a class="button button-primary" href="@Url.Action("Index", "Liquidity")">Explorar pools <span aria-hidden="true">↗</span></a><a class="button" href="@Url.Action("Create", "Tokens")">Criar um token →</a></div>
        <aside class="dex-network"><span class="eyebrow">UMA REDE. NOVAS POSSIBILIDADES.</span><div class="dex-orbit" aria-hidden="true"><span>P</span><i>◇</i><b>⇄</b></div><strong>Blockchain POVIX</strong><p>Seus ativos. Sua carteira. Seu controle.</p></aside>
    </section>
    <section class="dex-metrics" aria-label="Resumo do catálogo"><div><span>Ativos no catálogo</span><strong id="dex-asset-count">—</strong></div><div><span>Pools disponíveis</span><strong id="dex-pool-count">—</strong></div><div><span>Rede de negociação</span><strong>POVIX <em>Nativa</em></strong></div></section>
    <section class="card dex-list" aria-labelledby="dex-list-title">
        <div class="dex-list-heading"><div><span class="eyebrow">DESCUBRA O ECOSSISTEMA</span><h2 id="dex-list-title">Tokens listados</h2><p>Ativos confirmados na blockchain e suas pools de negociação.</p></div><button id="dex-refresh" class="button button-secondary" type="button">Atualizar ↻</button></div>
        <div class="dex-tools"><div class="dex-tabs" role="group" aria-label="Filtrar tokens"><button type="button" data-filter="all" aria-pressed="true">Todos os tokens</button><button type="button" data-filter="pools" aria-pressed="false">Com pool disponível</button></div><div><label class="dex-search-label" for="dex-search">Buscar token</label><input type="search" id="dex-search" placeholder="Nome, símbolo ou ID do token" /></div></div>
        <p id="dex-status" class="dex-status" role="status" aria-live="polite">Consultando o catálogo da rede…</p>
        <div class="dex-table-wrap"><table class="dex-table"><thead><tr><th scope="col">Token</th><th scope="col">Identificação</th><th scope="col">Pools disponíveis</th><th scope="col">Negociação</th></tr></thead><tbody id="dex-token-list"></tbody></table></div>
        <div class="dex-list-footer"><span id="dex-result-count">Aguardando catálogo</span><span>Disponibilidade conforme esta instalação do DEX.</span></div>
    </section>
    <p class="dex-disclaimer">Os ativos listados não representam recomendação de investimento. Tokens sem pool disponível ainda não podem ser negociados aqui.</p>
</main>
@section scripts {
    <script src="@Url.Content("~/Scripts/povix-home.js")"></script>
}
