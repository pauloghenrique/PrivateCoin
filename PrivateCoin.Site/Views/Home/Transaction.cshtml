@model PrivateCoin.Site.Models.HomeViewModel
@using PrivateCoin.Site.Models
@{
    ViewBag.Title = "Detalhes da transação";
    var entry = Model.Ledger[0];
}
<main class="explorer container">
    <header class="explorer-header"><div><p class="eyebrow">Blockchain pública</p><h1>Detalhes da transação</h1><a href="@Url.Action("Explorer", "Home")">← Voltar ao explorador</a></div></header>
    <section class="panel" aria-label="Detalhes da operação">
        <dl>
            <dt>Hash da transação</dt><dd style="overflow-wrap:anywhere"><code>@entry.TransactionId</code></dd>
            <dt>Bloco</dt><dd>#@entry.BlockHeight</dd>
            <dt>Hash do bloco</dt><dd style="overflow-wrap:anywhere"><code>@entry.BlockHash</code></dd>
            <dt>Confirmações</dt><dd>@entry.Confirmations</dd>
            <dt>Data (UTC)</dt><dd>@(new DateTime(entry.TimestampUtcTicks, DateTimeKind.Utc).ToString("dd/MM/yyyy HH:mm:ss"))</dd>
            <dt>Tipo</dt><dd>@HomeViewModel.EntryTypeName(entry)</dd>
            <dt>Token</dt><dd>@Model.LedgerTokenName(entry)</dd>
            <dt>Valor</dt><dd>@Model.FormatLedgerAmount(entry)</dd>
            <dt>Taxa</dt><dd>@HomeViewModel.FormatTokens(entry.Fee)</dd>
            <dt>Emissão</dt><dd>@HomeViewModel.FormatTokens(entry.IssuedAmount)</dd>
        </dl>
    </section>
    <section class="panel" aria-labelledby="outputs-title">
        <h2 id="outputs-title">Saídas da transação</h2>
        <div class="table-responsive"><table class="table ledger-table">
            <thead><tr><th>Endereço de uso único</th><th>Valor</th></tr></thead>
            <tbody>@foreach (var output in entry.Outputs) {
                <tr><td style="overflow-wrap:anywhere;white-space:normal"><code>@output.OneTimeAddress</code></td><td>@Model.FormatAssetAmount(output.Amount, output.AssetId)</td></tr>
            }</tbody>
        </table></div>
    </section>
</main>
