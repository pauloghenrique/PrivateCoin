@model PrivateCoin.Site.Models.HomeViewModel
@using PrivateCoin.Site.Models
@{
    ViewBag.Title = "Explorador";
}

<main class="explorer">
    <header class="explorer-header">
        <p class="eyebrow">Blockchain pública</p>
        <h1>PrivateCoin</h1>
        <p class="lead">Emissão e livro-caixa consultados diretamente pelo PrivateCoin.Core.</p>
    </header>

    <section class="row g-3 summary" aria-label="Resumo da emissão">
        <div class="col-md-3">
            <article class="stat-card">
                <span>Tokens iniciais emitidos</span>
                <strong>@HomeViewModel.FormatTokens(Model.Summary.InitialDistributionTokenAmount)</strong>
                <small>@Model.Summary.InitialDistributionBlocksIssued.ToString("N0") emitidas, @Model.Summary.InitialDistributionBlocksRemaining.ToString("N0") restantes</small>
            </article>
        </div>
        <div class="col-md-3">
            <article class="stat-card">
                <span>Tokens emitidos</span>
                <strong>@HomeViewModel.FormatTokens(Model.Summary.IssuedTokenAmount)</strong>
                <small>@Model.Summary.IssuedBlockCount.ToString("N0") blocos emitidos</small>
            </article>
        </div>
        <div class="col-md-3">
            <article class="stat-card">
                <span>Oferta total programada</span>
                <strong>@HomeViewModel.FormatTokens(Model.Summary.MaximumTokenAmount)</strong>
                <small>Distribuição inicial + proof-of-stake</small>
            </article>
        </div>
        <div class="col-md-3">
            <article class="stat-card accent">
                <span>Próxima recompensa</span>
                <strong>@HomeViewModel.FormatTokens(Model.Summary.CurrentReward)</strong>
                <small>Recompensa do próximo bloco</small>
            </article>
        </div>
    </section>

    <section class="ledger" aria-labelledby="ledger-title">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Transparência</p>
                <h2 id="ledger-title">Livro-caixa</h2>
            </div>
            <span>@Model.Ledger.Count registros exibidos</span>
        </div>

        @if (Model.Ledger.Count == 0)
        {
            <div class="empty-state">Nenhuma movimentação foi registrada até agora.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table ledger-table">
                    <thead><tr><th>Bloco</th><th>Tipo</th><th>Transação</th><th>Saídas</th><th>Taxa</th><th>Emissão</th></tr></thead>
                    <tbody>
                    @foreach (var entry in Model.Ledger)
                    {
                        <tr>
                            <td>#@entry.BlockHeight</td>
                            <td><span class="entry-type">@HomeViewModel.EntryTypeName(entry.Type)</span></td>
                            <td><code title="@entry.TransactionId">@entry.TransactionId.Substring(0, Math.Min(12, entry.TransactionId.Length))&hellip;</code></td>
                            <td>@HomeViewModel.FormatTokens(entry.OutputAmount)</td>
                            <td>@HomeViewModel.FormatTokens(entry.Fee)</td>
                            <td>@HomeViewModel.FormatTokens(entry.IssuedAmount)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>
